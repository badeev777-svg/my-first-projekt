# Пусто = режим DEMO (модель не вызывается).
CLOUDRU_API_KEY=
# Уведомления о заявках менеджеру в Telegram. Оба пустые = заявки только в логе (заглушка).
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=
# Бот в MAX: токен из business.max.ru и секрет вебхука (5–256 символов a-zA-Z0-9_-). Оба пустые = канал выключен.
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
# ВКонтакте (Callback API): ключ сообщества с правом «сообщения», секретный ключ и строка подтверждения. Все три = канал включён.
VK_GROUP_TOKEN=
VK_SECRET=
VK_CONFIRMATION=
# Avito Messenger API: client_id/client_secret из developers.avito.ru, номер профиля и секрет для адреса вебхука.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_USER_ID=
AVITO_WEBHOOK_SECRET=
