# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your_key_here
MODEL_NAME=claude-opus-4-8
ENABLE_PROMPT_CACHING=true

# Database
DATABASE_URL=postgresql+asyncpg://bot:bot@localhost:5432/content_agent
# Для локальных тестов: sqlite+aiosqlite:///./data/bot.db

# Логирование
LOG_LEVEL=INFO

# Алерты для CRITICAL ошибок (Telegram chat_id админа)
ADMIN_TELEGRAM_CHAT_ID=

# Telegram Payments (получить от @BotFather → /mybots → Payments)
TELEGRAM_PAYMENT_TOKEN=

# Лимиты
FREE_GENERATIONS=3
SUBSCRIPTION_PRICE_RUB=2499
RATE_LIMIT_PER_HOUR=1
MAX_REWRITES_PER_POST=3
SCRAPER_TIMEOUT_SECONDS=15

# Beget hosting (production deployment)
BEGET_SSH_HOST=your_beget_ssh_host
BEGET_SSH_USER=your_beget_ssh_user
BEGET_SSH_PASSWORD=your_beget_ssh_password
BEGET_CONTROL_PANEL=https://cp.beget.com
BEGET_FTP_HOST=your_beget_ftp_host
BEGET_FTP_USER=your_beget_ftp_user
BEGET_FTP_PASSWORD=your_beget_ftp_password
BEGET_ACCOUNT_ID=your_beget_account_id
