# ============================================================================
# TELEGRAM BOT CONFIGURATION
# ============================================================================
# Choose audience: students or adults (default: adults)
# This determines which bot token is used and what scenarios are available
AUDIENCE=adults

# Get from: https://t.me/BotFather (create new bot)
# Command: /newbot → follow prompts → copy token

# Bot token for STUDENTS audience (conversations about exams, dorm, clubs, etc.)
TELEGRAM_TOKEN_STUDENTS=your_telegram_token_students_from_botfather

# Bot token for ADULTS audience (conversations about work, business, travel, etc.)
TELEGRAM_TOKEN_ADULTS=your_telegram_token_adults_from_botfather

# Fallback token (if only one bot for now or AUDIENCE not set)
TELEGRAM_TOKEN=your_telegram_token_from_botfather

# For webhook mode (optional, for production)
WEBHOOK_URL=https://your-domain.com/webhook

# ============================================================================
# OPENROUTER API CONFIGURATION
# ============================================================================
# Get from: https://openrouter.io/account/keys
# Available models: anthropic/claude-3-5-sonnet, anthropic/claude-3-opus, openai/gpt-4, etc.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Development: SQLite (no setup needed, creates local file)
DATABASE_URL=sqlite+aiosqlite:///./speakbuddy.db

# Production: PostgreSQL (uncomment and fill in your credentials)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/speakbuddy
# Example: postgresql+asyncpg://speakbuddy:password123@db.example.com:5432/speakbuddy

# ============================================================================
# ENVIRONMENT & DEBUG
# ============================================================================
# development = local testing, production = deployed
ENVIRONMENT=development

# Enable debug logging (True for development, False for production)
DEBUG=True

# ============================================================================
# PAYMENT CONFIGURATION (Yandex Kassa / YuKassa)
# ============================================================================
# Get from: https://yookassa.ru (create merchant account)
# Shop ID is your account ID
# API key from Settings → API keys → create new

# YuKassa API Secret Key (keep this secret!)
YUKASSA_API_KEY=your_yukassa_api_key_here

# Your YuKassa Shop ID (public)
YUKASSA_SHOP_ID=your_shop_id_here

# ============================================================================
# HOW TO RUN DIFFERENT BOTS
# ============================================================================
# Run Students bot:
#   AUDIENCE=students python -m src.main

# Run Adults bot:
#   AUDIENCE=adults python -m src.main

# Run with default (fallback TELEGRAM_TOKEN):
#   python -m src.main
