# Telegram userbot (для чтения каналов через Telethon)
# Получить на https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Telegram-бот (для уведомлений)
# Создать через @BotFather
BOT_TOKEN=
BOT_CHAT_ID=

# Список Telegram-каналов для мониторинга (через запятую, без @)
TG_CHANNELS=freelance_ru,web_zakazy,seo_zakazy

# Ключевые слова для фильтрации (через запятую)
KEYWORDS=нужен сайт,сделайте сайт,разработка сайта,создание сайта,лендинг,интернет-магазин,продвижение сайта,SEO,контекстная реклама,верстка

# Минимальный бюджет в рублях (0 = без ограничений)
MIN_BUDGET=0

# Интервал опроса источников в минутах
POLL_INTERVAL_MINUTES=10

# Демо-режим (true = загружает фейковые данные, отключает планировщик)
DEMO_MODE=false

# Anthropic API для анализа лидов через Claude Opus 4.8
# Получить на https://console.anthropic.com
ANTHROPIC_API_KEY=
