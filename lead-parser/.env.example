# Telegram userbot (для чтения каналов через Telethon)
# Получить на https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# Telegram-бот (для уведомлений)
# Создать через @BotFather
BOT_TOKEN=
BOT_CHAT_ID=

# Список Telegram-каналов для мониторинга (через запятую, без @)
TG_CHANNELS=freelance_ru,web_zakazy,seo_zakazy

# Ключевые слова для фильтрации (через запятую)
KEYWORDS=нужен сайт,сделайте сайт,разработка сайта,создание сайта,лендинг,интернет-магазин,продвижение сайта,SEO,контекстная реклама,верстка

# Минимальный бюджет в рублях (0 = без ограничений)
MIN_BUDGET=0

# Интервал опроса источников в минутах
POLL_INTERVAL_MINUTES=10

# Демо-режим (true = загружает фейковые данные, отключает планировщик)
DEMO_MODE=false

# GigaChat через cloud.ru Foundation Models (OpenAI-совместимый API) для анализа лидов
# Получить API-ключ: личный кабинет cloud.ru → Пользователи → Сервисные аккаунты →
# создать аккаунт → API-ключи → сервис Foundation Models
GIGACHAT_API_KEY=
GIGACHAT_MODEL=ai-sage/GigaChat3-10B-A1.8B

# VK API — для мониторинга групп с заказами
# Получить: vk.com/dev → Создать приложение → Настройки → Сервисный ключ
VK_TOKEN=
# Список групп VK через запятую (без @, только slug)
VK_GROUPS=freelance_pro,web_zakazy,seo_zakazy,it_freelance

# YouDo — логин/пароль аккаунта для авторизованного скрапинга заказов
YOUDO_LOGIN=
YOUDO_PASSWORD=
