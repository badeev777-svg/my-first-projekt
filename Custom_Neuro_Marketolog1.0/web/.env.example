# GigaChat через cloud.ru Foundation Models (OpenAI-совместимый API)
# Получить API-ключ: личный кабинет cloud.ru → Пользователи → Сервисные аккаунты →
# создать аккаунт → API-ключи → сервис Foundation Models
CLOUD_RU_API_KEY=your_cloud_ru_key
MODEL=ai-sage/GigaChat3.5-432B-A28B
MAX_TOKENS=14000

# Брендинг (white-label) — замени под каждого клиента
AGENT_NAME=Нейро-Маркетолог
AGENT_INITIALS=НМ
AGENCY_NAME=Badeev Agency
AGENCY_TAGLINE=AI-автоматизация бизнеса
CONTACT_LINK=https://t.me/badeev777
WA_LINK=
MAX_LINK=

# White-label: true — только чат на весь экран, автостарт (без лендинга)
CHAT_ONLY_MODE=false

# Живые данные: автопарсинг сайта клиента (по ссылке из интервью) для отчёта
# Отключи, если фича мешает конкретному white-label клиенту
ENABLE_SITE_FETCH=true
SITE_FETCH_TIMEOUT=6.0
SITE_FETCH_MAX_BYTES=1000000
SITE_FETCH_MAX_CHARS=4000

# Токены разблокировки платных разделов отчёта (через запятую)
# Каждый токен выдаётся клиенту индивидуально
UNLOCK_TOKENS=

# Уведомления — Telegram
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# Уведомления — MAX messenger
MAX_BOT_TOKEN=your_max_bot_token
MAX_USER_ID=your_max_user_id

# Admin CRM Dashboard
ADMIN_LOGIN=alex
ADMIN_PASSWORD=your_secure_password
ADMIN_URL=https://аналитик.бизнесгенератор.рф/admin
