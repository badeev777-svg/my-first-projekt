TELEGRAM_BOT_TOKEN=123456:your-bot-father-token
ALLOWED_USER_ID=123456789
ANTHROPIC_API_KEY=sk-ant-your-key
# Alternative: route through a proxy (e.g. Polza.ai) instead of direct billing.
# Leave ANTHROPIC_API_KEY blank when using these two.
# ANTHROPIC_BASE_URL=https://polza.ai/api
# ANTHROPIC_AUTH_TOKEN=pza_your-key
PROJECTS={"aleks": "/root/projects/Aleks", "content-agent-bot": "/root/projects/content-agent-bot"}
# Root folder for projects created from Telegram via the "новый проект <name>"
# trigger phrase (see docs/superpowers/specs/2026-07-26-dynamic-projects-design.md).
# Defaults to /root/user-projects if unset.
PROJECTS_ROOT=/root/user-projects
# Claude model alias for the Agent SDK: sonnet/opus/haiku. Defaults to sonnet
# in code if unset -- pick opus only when you deliberately want it (much pricier).
MODEL=sonnet
CONFIRMATION_TIMEOUT_SECONDS=600
# Hard ceiling on one run_turn() call so a hung SDK/subprocess can't block
# a turn forever. Keep well above CONFIRMATION_TIMEOUT_SECONDS.
RUN_TURN_TIMEOUT_SECONDS=1200
DB_PATH=state.db
LOG_LEVEL=INFO
